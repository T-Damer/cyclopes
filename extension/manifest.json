{
  "manifest_version": 3,
  "name": "Cyclopes — Local AI Image Detector",
  "version": "0.2.0",
  "description": "Detects AI-generated web images locally in your browser — no uploads.",
  "icons": {"16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png", "128": "icons/off-128.png"},
  "permissions": ["activeTab", "contextMenus", "offscreen", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {"16": "icons/off-16.png", "32": "icons/off-32.png"},
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ort/*.wasm", "ort/*.mjs", "ort/ort.js", "models/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
